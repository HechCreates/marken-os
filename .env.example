NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=markenos.internal

# Server-side only. Never prefix with NEXT_PUBLIC_ — it bypasses every RLS policy.
# Only needed by supabase/seed/seed.mjs, not by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Shown on the login page as the demo credentials, next to the seeded
# usernames. Must match the DEMO_PASSWORD used when seed.mjs ran. Unset, the
# login page offers no demo accounts. NEXT_PUBLIC_ values are inlined at BUILD
# time, so set it before the build, not just at runtime.
NEXT_PUBLIC_DEMO_PASSWORD=
